{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --project taskhub-next",
    "logs": "firebase functions:log --project taskhub-next"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@googleapis/calendar": "^20.1.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "google-auth-library": "^11.3.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
